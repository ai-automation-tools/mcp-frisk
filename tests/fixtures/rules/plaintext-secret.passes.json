{
  // Keys passed by reference, short prefixes that aren't keys, and plain config values.
  "mcpServers": {
    "env-references": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "OPENAI_API_KEY": "${input:openai-key}"
      }
    },
    "lookalikes": {
      "command": "node",
      "args": ["server.js", "--mode", "sk-short", "--task", "task-ask-ant-colony-simulation", "hf_small", "AKIA"],
      "env": { "STRIPE_MODE": "sk_test_", "LOG_LEVEL": "debug" }
    },
    "remote": { "type": "http", "url": "https://mcp.example.test/mcp" }
  }
}
