// VS Code workspace MCP config: JSONC, with a `servers` block.
{
  "inputs": [
    { "type": "promptString", "id": "api-key", "description": "API key", "password": true }
  ],
  "servers": {
    /* a remote server has no command to check */
    "docs-search": { "type": "http", "url": "https://mcp.example.test/mcp" },
    "fetch": { "type": "stdio", "command": "uvx", "args": ["mcp-server-fetch"] }, // trailing comma next
  },
}
