{
  "name": "mcpfrisk",
  "version": "0.0.0",
  "description": "An offline linter for MCP configs: flags shell-injection shapes and plaintext secrets without starting any server.",
  "type": "module",
  "license": "MIT",
  "author": "Mike Schecht",
  "bin": {
    "mcpfrisk": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-site.ts",
    "test": "node --test",
    "lint": "eslint . && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
